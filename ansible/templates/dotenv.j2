# Généré par ansible/playbooks/deploy.yml depuis group_vars/dev/vars.yml et
# group_vars/dev/vault.yml — ne pas éditer à la main (écrasé à chaque
# déploiement). Pour changer une valeur : éditer ces fichiers, pas ce .env.
APP_DOMAIN={{ app_domain }}
API_DOMAIN={{ api_domain }}
ADMIN_DOMAIN={{ admin_domain }}
BACKOFFICE_DOMAIN={{ backoffice_domain }}

POSTGRES_DB={{ postgres_db }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
POSTGRES_IMAGE={{ postgres_image }}

FISHOLA_JWT_SECRET={{ vault_fishola_jwt_secret }}
FISHOLA_ADMIN_PASSWORD={{ vault_fishola_admin_password }}
DJANGO_SECRET_KEY={{ vault_django_secret_key }}

SMTP_HOST={{ smtp_host }}
SMTP_PORT={{ smtp_port }}

BACKEND_PORT={{ backend_port }}
MOBILE_PORT={{ mobile_port }}
ADMIN_PORT={{ admin_port }}
BACKOFFICE_PORT={{ backoffice_port }}
MAILDEV_PORT={{ maildev_port }}
